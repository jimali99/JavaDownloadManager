{
  "manifest_version": 3,
  "name": "Java Download Manager (JDM Integration)",
  "version": "1.1.0",
  "description": "Seamlessly detects videos, media streams, and redirects Chrome downloads to Java Download Manager for up to 10x faster multi-threaded speeds.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "notifications",
    "activeTab",
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:9614/*",
    "http://localhost:9614/*",
    "*://*.youtube.com/*",
    "*://*.google.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Java Download Manager (JDM Video Sniffer)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
